
  title: Python For Loop Practice
  description: Beginner Python programs demonstrating the use of for loops to solve common problems.

problems:
  - id: 1
    title: Print Numbers from 1 to 10
    question: Print numbers from 1 to 10 using a for loop.
    code: |
      for i in range(1, 11):
          print(i)

  - id: 2
    title: Print Even Numbers from 2 to 20
    question: Print all even numbers between 2 and 20.
    code: |
      for i in range(2, 21):
          if i % 2 == 0:
              print(i)

  - id: 3
    title: Sum of Numbers from 1 to 5
    question: Calculate the sum of numbers from 1 to 5.
    code: |
      total = 0

      for i in range(1, 6):
          total += i

      print(total)

  - id: 4
    title: Count Vowels in a Word
    question: Count the number of vowels in the word "APPLE".
    code: |
      word = "APPLE"
      vowels = 0

      for ch in word:
          if ch in "AEIOUaeiou":
              vowels += 1

      print(vowels)

  - id: 5
    title: Count Elements in a List
    question: Find the number of elements in a list without using len().
    code: |
      arr = ["man", "guv", "app"]

      count = 0

      for item in arr:
          count += 1

      print(count)

  - id: 6
    title: Find the Largest Number
    question: Find the maximum element in a list.
    code: |
      arr = [8, 3, 12, 5, 10]

      largest = arr[0]

      for num in arr:
          if num > largest:
              largest = num

      print(largest)

  - id: 7
    title: Print Characters of a String
    question: Print each character of the string "hello" on a new line.
    code: |
      word = "hello"

      for ch in word:
          print(ch)

  - id: 8
    title: Multiplication Table of 5
    question: Display the multiplication table of 5.
    code: |
      n = 5

      for i in range(1, 11):
          print(n * i)

  - id: 9
    title: Reverse Counting
    question: Print numbers from 10 to 2 in reverse order.
    code: |
      for i in range(10, 1, -1):
          print(i)

  - id: 10
    title: Find Index of an Element
    question: Find the index of the number 9 in a list.
    code: |
      arr = [4, 7, 2, 9, 5]
      target = 9

      for index, num in enumerate(arr):
          if num == target:
              print(index)

